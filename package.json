{
  "name": "@aikofy/client-db",
  "version": "0.1.0",
  "description": "IndexedDB sync wrapper with HLC, conflict resolution, and WebRTC gossip sync",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bunx tsup",
    "dev": "bunx tsup --watch",
    "test": "bun run vitest run",
    "test:watch": "bun run vitest",
    "test:coverage": "bun run vitest run --coverage",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "fake-indexeddb": "^6.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "author": "Lwin Maung Maung",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "indexeddb",
    "sync",
    "webrtc",
    "hlc",
    "offline-first",
    "crdt"
  ],
  "license": "MIT"
}
